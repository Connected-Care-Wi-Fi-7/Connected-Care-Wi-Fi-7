#!/bin/sh
# Runs the same Rust checks as CI before anything is pushed.
# See "Local checks" in CONTRIBUTING.md.

zero=0000000000000000000000000000000000000000

# Git sends one line per ref: <local ref> <local sha> <remote ref> <remote sha>.
# Skip the checks when the push only deletes branches.
only_deletes=true
while read -r _ local_sha _ _; do
    [ "$local_sha" = "$zero" ] || only_deletes=false
done
[ "$only_deletes" = true ] && exit 0

run() {
    echo "pre-push: $*" >&2
    "$@" || {
        echo "pre-push: failed: $*" >&2
        echo "  Fix it, or push with --no-verify if you must (CI will still check)." >&2
        exit 1
    }
}

run cargo fmt --all -- --check
run cargo clippy --workspace --all-targets -- -D warnings
run cargo test --workspace
